# Backend only: keep this file on the VPS, never package it into the launcher.
PUBLIC_URL=https://launcher.fixedbydesign.com
DISCORD_CLIENT_ID=1550108117360967710
DISCORD_CLIENT_SECRET=
# Generate each value separately: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
PUBLISH_TOKEN=
